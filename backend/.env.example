# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-secret-key

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration
# Local SQLite default: sqlite:///champions_club_dev.db
# Docker Compose PostgreSQL: postgresql://champions_user:champions_password@localhost:5432/champions_club
# Production PostgreSQL: postgresql://<user>:<password>@<host>:5432/<dbname>
DATABASE_URL=sqlite:///champions_club_dev.db

# Test Database URL (optional, defaults to sqlite:///:memory: if omitted)
# TEST_DATABASE_URL=postgresql://champions_user:champions_password@localhost:5432/champions_test

# Redis & Celery (Default port: 6379)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Docker Compose Service Ports (Optional overrides)
POSTGRES_USER=champions_user
POSTGRES_PASSWORD=champions_password
POSTGRES_DB=champions_club
POSTGRES_PORT=5432
REDIS_PORT=6379

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Configuration (Online Payments)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Server
PORT=5000
HOST=0.0.0.0

