# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-me-to-a-secure-random-secret-key

# JWT Configuration
JWT_SECRET_KEY=change-me-to-a-secure-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# Database Configuration
# Local SQLite default: sqlite:///champions_club_dev.db
# PostgreSQL deploy: postgresql://user:password@localhost:5432/champions_club
DATABASE_URL=sqlite:///champions_club_dev.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Razorpay Configuration (Online Payments)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Server
PORT=5000
HOST=0.0.0.0
